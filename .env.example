# --- Server ---
NODE_ENV=development
PORT=3000

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
DB_NAME=apihub_legacy

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace_with_a_random_64_char_hex_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_a_different_random_64_char_hex_string
REFRESH_TOKEN_EXPIRY=10d

# --- CORS ---
# Full origin including scheme, no trailing slash
CORS_ORIGIN=http://localhost:5173

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ---
EMAIL_SERVICE=gmail
FROM_EMAIL=
APP_PASSWORD=

# --- Logging ---
LOG_LEVEL=info

# --- Queue (email jobs) — OPTIONAL ---
# If REDIS_URL is unset, verification emails send synchronously from the
# web process (no queue, no separate worker needed). Set it to enable
# the BullMQ-backed queue and run `npm run worker` as a separate process.
# Local dev value below matches docker-compose's bundled redis service.
# REDIS_URL=redis://localhost:6379
